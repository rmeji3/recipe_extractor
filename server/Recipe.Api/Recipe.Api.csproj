<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Feeds the XML doc comments on controllers and DTOs into the OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public member needs a doc comment, only the ones that earn it. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      `bin*` and `obj*`, not `bin` and `obj`. The IDE's Roslyn language server writes into
      a literal `bin\Debug` directory — one directory whose *name* contains a backslash,
      which the SDK's `bin/**` exclude does not match. Its contents were globbed as project
      content and copied a level deeper on every build, nesting until paths exceeded the
      filesystem limit and the build failed outright. The wildcard catches it whatever the
      IDE names it next.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin*/**;obj*/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Curated reference data, read at runtime. Versioned with the code because it is
         reviewed like code: a wrong ratio here ruins someone's dinner. -->
    <!-- Update, not Include: the Web SDK already globs .json as Content, and adding it
         again is a duplicate-item error. -->
    <Content Update="Data\Seed\IngredientRules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

</Project>
